# On Master da Web the bindings give these: the database (url layout) and the
# bucket (prefix MW_STORAGE_). Copy to .env only to run the API locally.
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_DIRECT_URL=postgresql://app:app@localhost:5432/app
MW_STORAGE_ENDPOINT=
MW_STORAGE_REGION=auto
MW_STORAGE_BUCKET=
MW_STORAGE_ACCESS_KEY_ID=
MW_STORAGE_SECRET_ACCESS_KEY=
MW_STORAGE_FORCE_PATH_STYLE=true
